# ============================================================================
# PRAHAR Environment Configuration Template
# COPY THIS FILE TO .env OR .env.local AND FILL IN ACTUAL VALUES.
# NEVER COMMIT ACTUAL SECRET-BEARING .env FILES TO SOURCE CONTROL.
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=3001

# Supabase Project Configuration
# SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co or http://localhost:54321)
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_ANON_KEY: Safe for client-side authentication and standard user requests
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# SUPABASE_SERVICE_ROLE_KEY: STRICTLY SERVER-ONLY.
# NEVER EXPOSE TO FLUTTER OR WEB BUNDLES. NEVER COMMIT TO GIT.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key-placeholder

# CORS Security (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Simulator / Rover Security Boundary
# In production, ALLOW_SIMULATOR_BYPASS MUST BE false (startup will abort if true).
# In development, setting this to true allows testing simulated scans without physical keys.
ALLOW_SIMULATOR_BYPASS=true

# Rover Device Ingestion Key (Required when ALLOW_SIMULATOR_BYPASS is false)
ROVER_API_KEY=dev-rover-device-api-key-placeholder

# External Providers
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
